# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent / editor tooling
.claude/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright / mcp debug artifacts (screenshots, console logs, snapshots)
.playwright-mcp/
/*.png

# typescript
*.tsbuildinfo

# font files (large, download via script)
scripts/fonts/
next-env.d.ts
